#version 450
#extension GL_EXT_shader_16bit_storage : require

// Turns the panel scanout into NV12 for the hardware encoder in one pass.
//
// Every output pixel gets its source position from a coarse lookup grid. The
// grid either maps the output to a straight crop of the panel (raw view) or
// undoes the lens distortion for one or blended eyes. Each grid point stores a position per
// color channel, because the compositor pre-corrects chromatic aberration and
// we need to undo that too. A negative position means "outside the lens", which
// gets painted black.

#define STEP 8u
#define TILE_W 32u
#define TILE_H 8u
#define CELLS (TILE_W / STEP)
#define POINTS_X (CELLS + 1u)
#define SLOT_ROW 8u
#define SLOT_POINTS (SLOT_ROW * 2u)
#define CHANNEL_SLOTS (3u * SLOT_POINTS)
#define WORKGROUP_SIZE 64u
#define TILES_PER_DISPATCH_ROW 256u

layout(local_size_x = 16, local_size_y = 4, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D src_tex;
layout(set = 0, binding = 1, std430) readonly buffer Lut { vec2 lut[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Nv12 { uint16_t nv12[]; };
layout(set = 0, binding = 3, std430) readonly buffer Tiles { uint tiles[]; };

layout(push_constant) uniform Params {
    uvec2 out_size;
    uvec2 lut_size;
    uint y_stride;
    uint uv_offset;
    uint first_tile;
    uint tile_count;
    float zero;
} p;

layout(constant_id = 0) const uint FLAGS = 0u;
layout(constant_id = 1) const bool BLENDS_EYES = false;

const bool PER_CHANNEL = (FLAGS & 1u) != 0u;
const bool SUPERSAMPLE = (FLAGS & 2u) != 0u;
const bool ROTATED_EYES = (FLAGS & 4u) != 0u;
const bool SHARP = (FLAGS & 8u) != 0u;
const bool TWO_EYE_GRID = (FLAGS & 16u) != 0u;

const uint CELL_SHOWN = 1u;
const uint CELL_OWN_RED_BLUE = 2u;
const uint CELL_NO_RED = 4u;
const uint CELL_NO_BLUE = 8u;
const uint CELL_RIGHT_EYE_SHIFT = 4u;
const uint CELL_BLENDED = 32u;
const uint OTHER_EYE_SHIFT = 5u;

const uint WEIGHT_SLOT = 6u;

shared vec2 s_lut[7u * SLOT_POINTS];
shared uint s_cell_needs[CELLS];

// One grid cell for one channel: a corner plus how the source moves per
// output pixel along x and y, and the bilinear twist term.
struct Cell {
    vec2 origin;
    vec2 dx;
    vec2 dy;
    vec2 dxy;
};

float wait_for(float earlier) {
    return SHARP ? earlier * p.zero : 0.0;
}

Cell load_cell(uint i, uint slot, float earlier) {
    uint base = slot * SLOT_POINTS + i;
    vec2 a = s_lut[base] + wait_for(earlier);
    vec2 b = s_lut[base + 1u];
    vec2 d = s_lut[base + SLOT_ROW];
    vec2 e = s_lut[base + SLOT_ROW + 1u];

    Cell cell;
    const float inv = 1.0 / float(STEP);
    cell.origin = a;
    cell.dx = (b - a) * inv;
    cell.dy = (d - a) * inv;
    cell.dxy = (e - d - b + a) * (inv * inv);
    return cell;
}

vec2 cell_uv(Cell cell, vec2 local) {
    return cell.origin + cell.dx * local.x + cell.dy * local.y + cell.dxy * (local.x * local.y);
}

// The grid is in the eyes' own panel space, as SteamVR describes it. The
// Frame scans each eye's half out turned 180° in place, so turn it back
// here, per sample, which keeps the seam between the eyes clean.
// Catmull-Rom in 5 bilinear taps (the four far corners dropped, they
// barely matter). Crisper than plain bilinear, which matters here because
// the panel image has already been resampled once by the compositor.
vec4 catmull_rom(vec2 uv) {
    vec2 size = vec2(textureSize(src_tex, 0));
    vec2 pos = uv * size;
    vec2 center = floor(pos - 0.5) + 0.5;
    vec2 f = pos - center;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 tc0 = (center - 1.0) / size;
    vec2 tc3 = (center + 2.0) / size;
    vec2 tc12 = (center + w2 / w12) / size;
    vec4 c = textureLod(src_tex, vec2(tc12.x, tc0.y), 0.0) * (w12.x * w0.y)
           + textureLod(src_tex, vec2(tc0.x, tc12.y), 0.0) * (w0.x * w12.y)
           + textureLod(src_tex, tc12, 0.0) * (w12.x * w12.y)
           + textureLod(src_tex, vec2(tc3.x, tc12.y), 0.0) * (w3.x * w12.y)
           + textureLod(src_tex, vec2(tc12.x, tc3.y), 0.0) * (w12.x * w3.y);
    float norm = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(c / norm, 0.0);
}

vec4 fetch(vec2 uv) {
    if (ROTATED_EYES) {
        uv = vec2(uv.x < 0.5 ? 0.5 - uv.x : 1.5 - uv.x, 1.0 - uv.y);
    }
    if (SHARP) {
        return catmull_rom(uv);
    }
    return textureLod(src_tex, uv, 0.0);
}

vec4 sample_at(Cell cell, vec2 local, float earlier) {
    vec2 uv = cell_uv(cell, local) + wait_for(earlier);
    if (!SUPERSAMPLE) {
        return fetch(uv);
    }
    // 4 taps on a rotated grid, a cheap box filter for when we shrink.
    vec2 fx = cell.dx + cell.dxy * local.y;
    vec2 fy = cell.dy + cell.dxy * local.x;
    return 0.25 * (fetch(uv + fx * -0.375 + fy * -0.125) +
                   fetch(uv + fx *  0.125 + fy * -0.375) +
                   fetch(uv + fx *  0.375 + fy *  0.125) +
                   fetch(uv + fx * -0.125 + fy *  0.375));
}

// BT.709, limited range. The scanout is already gamma encoded, which is what
// the video matrix expects, so no transfer conversion here.
uint luma(vec3 c) {
    float y = dot(c, vec3(0.2126, 0.7152, 0.0722));
    return uint(clamp(16.0 + 219.0 * y + 0.5, 0.0, 255.0));
}

uint chroma(vec3 c) {
    float y = dot(c, vec3(0.2126, 0.7152, 0.0722));
    float cb = (c.b - y) / 1.8556;
    float cr = (c.r - y) / 1.5748;
    uint u = uint(clamp(128.0 + 224.0 * cb + 0.5, 0.0, 255.0));
    uint v = uint(clamp(128.0 + 224.0 * cr + 0.5, 0.0, 255.0));
    return u | (v << 8);
}

vec2 pixel(vec2 local, uint k) {
    return local + vec2(float(k & 1u), float(k >> 1));
}

void read_block(uint ci, uint slot, vec2 local, inout float earlier, out vec3 px[4]) {
    Cell cell = load_cell(ci, slot, earlier);
    for (uint k = 0u; k < 4u; k++) {
        px[k] = sample_at(cell, pixel(local, k), earlier).rgb;
        earlier = px[k].g;
    }
}

vec4 read_channel(uint ci, uint eye_slot, uint needs, uint channel, vec2 local, inout float earlier) {
    bool own = (needs & CELL_OWN_RED_BLUE) != 0u;
    bool lost = (needs & (channel == 0u ? CELL_NO_RED : channel == 2u ? CELL_NO_BLUE : 0u)) != 0u;
    Cell cell = load_cell(ci, eye_slot + (own ? channel : 1u), earlier);
    vec4 value;
    for (uint k = 0u; k < 4u; k++) {
        value[k] = sample_at(cell, pixel(local, k), earlier)[channel];
        earlier = value[k];
    }
    return value * (lost ? 0.0 : 1.0);
}

vec3 blend(vec3 mine, vec3 other, float w) {
    return w <= 0.0 ? mine : (w >= 1.0 ? other : mix(mine, other, w));
}

float blend(float mine, float other, float w) {
    return w <= 0.0 ? mine : (w >= 1.0 ? other : mix(mine, other, w));
}

vec4 read_blended(uint ci, uint eye_slot, uint needs, uint channel, vec2 local, vec4 w, inout float earlier) {
    vec4 mine = read_channel(ci, eye_slot, needs, channel, local, earlier);
    vec4 other = read_channel(ci, 3u - eye_slot, needs >> OTHER_EYE_SHIFT, channel, local, earlier);
    vec4 both;
    for (uint k = 0u; k < 4u; k++) {
        both[k] = blend(mine[k], other[k], w[k]);
    }
    return both;
}

void load_item(uvec2 tile, uint tile_eye, uint item) {
    uint grids = BLENDS_EYES ? 2u * CHANNEL_SLOTS : CHANNEL_SLOTS;
    uint weights = BLENDS_EYES ? SLOT_POINTS : 0u;
    uint count = p.lut_size.x * p.lut_size.y;
    if (item < grids + weights) {
        uint x = item & (SLOT_ROW - 1u);
        uint gx = min(tile.x * CELLS + x, p.lut_size.x - 1u);
        uint gy = min(tile.y + ((item / SLOT_ROW) & 1u), p.lut_size.y - 1u);
        uint at = gy * p.lut_size.x + gx;
        uint slot_eye = item >= CHANNEL_SLOTS ? 1u : 0u;
        uint channel = item / SLOT_POINTS - slot_eye * 3u;
        uint eye = BLENDS_EYES ? slot_eye : tile_eye;
        if (x >= POINTS_X) {
            return;
        }
        if (item >= grids) {
            s_lut[item] = lut[count * 6u + at];
        } else if (PER_CHANNEL || channel == 1u) {
            s_lut[item] = lut[(eye * count + at) * 3u + channel];
        }
    } else if (item < grids + weights + CELLS) {
        uint cell = item - grids - weights;
        uint cx = min(tile.x * CELLS + cell, p.lut_size.x - 2u);
        uint cy = min(tile.y, p.lut_size.y - 2u);
        s_cell_needs[cell] = uint(lut[count * (TWO_EYE_GRID ? 7u : 3u) + cy * (p.lut_size.x - 1u) + cx].x);
    }
}

void load_tile(uvec2 tile, uint tile_eye) {
    load_item(tile, tile_eye, gl_LocalInvocationIndex);
    if (BLENDS_EYES) {
        load_item(tile, tile_eye, gl_LocalInvocationIndex + WORKGROUP_SIZE);
    }
    barrier();
}

void main() {
    uint index = gl_WorkGroupID.y * TILES_PER_DISPATCH_ROW + gl_WorkGroupID.x;
    if (index >= p.tile_count) {
        return;
    }
    uint entry = tiles[p.first_tile + index];
    uvec2 tile = uvec2(entry & 0xfffu, (entry >> 12) & 0xfffu);
    load_tile(tile, entry >> 24);

    uvec2 at = tile * uvec2(TILE_W, TILE_H) + gl_LocalInvocationID.xy * 2u;
    if (at.x >= p.out_size.x || at.y >= p.out_size.y) {
        return;
    }
    uint ci = gl_LocalInvocationID.x * 2u / STEP;
    vec2 local = vec2(float(at.x % STEP), float(at.y % STEP)) + 0.5;
    uint needs = s_cell_needs[ci];
    float shown = float(needs & CELL_SHOWN);
    float earlier = 0.0;

    vec3 px[4];
    if (BLENDS_EYES) {
        uint eye_slot = ((needs >> CELL_RIGHT_EYE_SHIFT) & 1u) * 3u;
        Cell weight = load_cell(ci, WEIGHT_SLOT, earlier);
        bool blended = (needs & CELL_BLENDED) != 0u;
        vec4 w;
        for (uint k = 0u; k < 4u; k++) {
            w[k] = blended ? clamp(cell_uv(weight, pixel(local, k)).x, 0.0, 1.0) : 0.0;
        }
        if (PER_CHANNEL) {
            vec4 r = read_blended(ci, eye_slot, needs, 0u, local, w, earlier);
            vec4 g = read_blended(ci, eye_slot, needs, 1u, local, w, earlier);
            vec4 b = read_blended(ci, eye_slot, needs, 2u, local, w, earlier);
            for (uint k = 0u; k < 4u; k++) {
                px[k] = vec3(r[k], g[k], b[k]) * shown;
            }
        } else {
            vec3 other[4];
            read_block(ci, eye_slot + 1u, local, earlier, px);
            read_block(ci, 4u - eye_slot, local, earlier, other);
            for (uint k = 0u; k < 4u; k++) {
                px[k] = blend(px[k], other[k], w[k]) * shown;
            }
        }
    } else if (PER_CHANNEL && ((s_cell_needs[0] | s_cell_needs[1] | s_cell_needs[2] | s_cell_needs[3]) & CELL_OWN_RED_BLUE) != 0u) {
        vec4 r = read_channel(ci, 0u, needs, 0u, local, earlier);
        vec4 g = read_channel(ci, 0u, needs, 1u, local, earlier);
        vec4 b = read_channel(ci, 0u, needs, 2u, local, earlier);
        for (uint k = 0u; k < 4u; k++) {
            px[k] = vec3(r[k], g[k], b[k]) * shown;
        }
    } else {
        read_block(ci, 1u, local, earlier, px);
        for (uint k = 0u; k < 4u; k++) {
            px[k] *= shown;
        }
    }

    nv12[(at.y * p.y_stride + at.x) >> 1] = uint16_t(luma(px[0]) | (luma(px[1]) << 8));
    nv12[((at.y + 1u) * p.y_stride + at.x) >> 1] = uint16_t(luma(px[2]) | (luma(px[3]) << 8));
    nv12[(p.uv_offset + (at.y >> 1) * p.y_stride + at.x) >> 1] = uint16_t(chroma((px[0] + px[1] + px[2] + px[3]) * 0.25));
}
