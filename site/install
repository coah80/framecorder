#!/bin/sh
# framecorder's installer, for the steam frame. in konsole (desktop mode) or
# over ssh:
#
#   curl -fsSL https://framecorder.coah80.com/install | sh
#
# this gets the real installer, a little terminal app (installer/, built on
# opentui), checks it and runs it. that installs or updates framecorder,
# offers the permission that lets it record the panels (it takes your
# password, and helps set one if steamos doesn't have one yet), or removes
# it. framecorder updates itself after that (see framecorder-update.timer).
#
# everything happens in main, called on the last line: sh has read the whole
# script by then, so the installer can have the terminal instead of curl's pipe.

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

main() {
    [ "$(uname -m)" = aarch64 ] || fail "this is for the steam frame, and this machine is $(uname -m)."
    # FRAMECORDER_DL points it at another release, for testing one
    dl=${FRAMECORDER_DL:-https://framecorder.coah80.com/dl}
    work=$(mktemp -d) || fail "couldn't make a folder to download into."
    trap 'rm -rf "$work"' EXIT

    echo "getting the installer (about 30 MB)..."
    curl -fL --progress-bar -o "$work/installer.zst" "$dl/framecorder-installer.zst" \
        && want=$(curl -fsSL "$dl/framecorder-installer.zst.sha256" | cut -d' ' -f1) \
        || fail "couldn't download the installer. is the frame online?"
    [ "$(sha256sum "$work/installer.zst" | cut -d' ' -f1)" = "$want" ] \
        || fail "the download got mangled on the way. run this again."
    zstd -dq "$work/installer.zst" -o "$work/framecorder-installer" && chmod +x "$work/framecorder-installer" \
        || fail "couldn't unpack the installer."
    "$work/framecorder-installer"
}

main "$@" </dev/tty
