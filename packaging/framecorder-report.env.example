# Server only. Put this file at ~/.config/framecorder-report/env with mode 0600.
# The unit runs ~/.local/bin/framecorder-report (cargo build --release in report/, then copy it there).
PORT=4791
REPO=coah80/framecorder
# Defaults to ~/.local/state/framecorder-report for the service user.
STATE_DIR=/home/cole/.local/state/framecorder-report
GITHUB_API=https://api.github.com
# STATE_DIR/app.env contains:
# APP_ID=5608340
# APP_SLUG=cobby-bot
# STATE_DIR/github-app.pem holds the existing app's PKCS#1 RSA key, mode 0600.
# GitHub credentials stay on the server. This service never writes either file.
