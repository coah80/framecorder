# Server only. Create STATE_DIR before starting the user unit.
# Put this file at ~/.config/framecorder-report/env with mode 0600.
# Adjust WorkingDirectory and ExecStart in the unit if the checkout is elsewhere.
PORT=4791
PUBLIC_URL=https://framecorder-report.coah80.com
REPO=coah80/framecorder
STATE_DIR=/home/cole/.local/state/framecorder-report
GITHUB_API=https://api.github.com
APP_NAME=framecorder-bot
# Run setup-link with this same environment, then open the printed link.
# No GitHub credentials belong in clients or in this file.
